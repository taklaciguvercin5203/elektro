---
/**
 * Sayı sistemi dönüşümünü interaktif olarak gösteren bileşen.
 * Kullanım:
 *   <NumberSystemConverter value="255" fromBase={10} />
 *   <NumberSystemConverter value="A5" fromBase={16} />
 *   <NumberSystemConverter value="1010" fromBase={2} />
 */

import * as ns from '../js/number-systems.js';

interface Props {
  /** Dönüştürülecek değer (sayı veya taban dizesi). */
  value: string | number;
  /** Girdi değerinin tabanı (2=ikili, 8=sekizli, 10=onluk, 16=HEX). */
  fromBase?: number;
  /** Girdi alanının etiketi. */
  inputLabel?: string;
  /** Girdi alanının placeholder'i. */
  inputPlaceholder?: string;
  /** Girdi değerinin varsayılan durumu (hata/boş durumunda önizleme). */
  preview?: boolean;
}

const {
  value,
  fromBase = ns.BASES.DECIMAL,
  inputLabel = 'Değer girin',
  inputPlaceholder = 'Sayı girin...',
  preview = false,
} = Astro.props;

// Girdi değeri ve tabanı güvenli hale getiriyoruz.
let inputValue: string = String(value ?? '').trim();
let inputBase: number = Number(fromBase);
let error: string | null = null;

let decimalValue: number | null = null;
let results = { binary: '—', octal: '—', decimal: '—', hex: '—' };
let asciiInfo = '—';

try {
  if (inputValue === '') {
    throw new Error('Değer boş olamaz.');
  }
  if (!Number.isInteger(inputBase) || inputBase < 2 || inputBase > 36) {
    throw new Error('Taban 2 ile 36 arasında olmalıdır.');
  }
  ns.normalizeBaseN(inputValue, inputBase, 'girdi');
  decimalValue = ns.baseToDecimal(inputValue, inputBase);
  results = {
    binary: ns.decimalToBinary(decimalValue),
    octal: ns.decimalToOctal(decimalValue),
    decimal: String(decimalValue),
    hex: ns.decimalToHex(decimalValue),
  };
  // ASCII: sayısal karşılığın karakteri (0-65535 aralığında anlamlı).
  try {
    asciiInfo = ns.asciiCodeToChar(decimalValue);
  } catch {
    asciiInfo = '—';
  }
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
  decimalValue = null;
}

function labelForBase(base: number): string {
  switch (base) {
    case ns.BASES.BINARY: return 'İkili (Binary)';
    case ns.BASES.OCTAL: return 'Sekizli (Octal)';
    case ns.BASES.DECIMAL: return 'Onluk (Decimal)';
    case ns.BASES.HEX: return 'Onaltılık (Hexadecimal)';
    default: return `${base} tabanı`;
  }
}

const baseOptions = [ns.BASES.BINARY, ns.BASES.OCTAL, ns.BASES.DECIMAL, ns.BASES.HEX];
---

<div
  class={`number-system-converter${error ? ' is-error' : ''}${preview ? ' is-preview' : ''}`}
  data-number-system-converter
>
  <div class="number-system-converter__header">
    <span class="number-system-converter__title">Sayı Dönüştürme Aracı</span>
    <span class="number-system-converter__sub" data-nsc-sub>
      {error ? 'Giriş kontrol edin' : 'Değeri seçilen tabandan diğer tabanlara çevir'}
    </span>
  </div>

  <div class="number-system-converter__body">
    <label class="number-system-converter__label">
      {inputLabel}
      {error ? (
        <span class="number-system-converter__error-marker" aria-hidden="true">⚠</span>
      ) : null}
    </label>

    <div class="number-system-converter__input-row">
      <input
        class={`number-system-converter__input${error ? ' is-error' : ''}`}
        type="text"
        value={inputValue}
        placeholder={inputPlaceholder}
        data-nsc-input
        data-testid="nsc-input"
      />

      <div class="number-system-converter__base-row">
        {baseOptions.map((base) => (
          <label class={`number-system-converter__base-option${inputBase === base ? ' is-active' : ''}`}>
            <input
              type="radio"
              name="nsc-base"
              value={base}
              checked={inputBase === base}
              data-nsc-base={base}
            />
            <span>{labelForBase(base)}</span>
          </label>
        ))}
      </div>
    </div>

    <p class="number-system-converter__error" role="alert" data-nsc-error hidden={!error}>
      {error ?? ''}
    </p>

    <div class="number-system-converter__results" data-nsc-results hidden={!!error}>
      <div class="number-system-converter__row">
        <span class="number-system-converter__label">İkili (Binary)</span>
        <span class="number-system-converter__value" data-nsc-out-binary>{results.binary}</span>
      </div>
      <div class="number-system-converter__row">
        <span class="number-system-converter__label">Sekizli (Octal)</span>
        <span class="number-system-converter__value" data-nsc-out-octal>{results.octal}</span>
      </div>
      <div class="number-system-converter__row number-system-converter__row--highlight">
        <span class="number-system-converter__label">Onluk (Decimal)</span>
        <span class="number-system-converter__value" data-nsc-out-decimal>{results.decimal}</span>
      </div>
      <div class="number-system-converter__row">
        <span class="number-system-converter__label">Onaltılık (Hexadecimal)</span>
        <span class="number-system-converter__value" data-nsc-out-hex>{results.hex}</span>
      </div>
      <div class="number-system-converter__row number-system-converter__row--ascii">
        <span class="number-system-converter__label">ASCII</span>
        <span class="number-system-converter__value" data-nsc-out-ascii>{asciiInfo}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .number-system-converter {
    /* Sabit koyu "cihaz kartı" paleti: sitenin teması ne olursa olsun aynı görünür. */
    --nsc-bg: #0f172a;
    --nsc-bg-soft: #1e293b;
    --nsc-bg-deep: #020617;
    --nsc-border: #334155;
    --nsc-border-strong: #475569;
    --nsc-ink: #f1f5f9;
    --nsc-ink-muted: #94a3b8;
    --nsc-accent: #f59e0b;
    --nsc-accent-ink: #0f172a;
    --nsc-green: #34d399;
    --nsc-blue: #38bdf8;
    --nsc-red: #f87171;
    --nsc-radius: 0.9rem;
    --nsc-mono: 'SF Mono', 'Fira Code', 'JetBrains Mono', ui-monospace, monospace;

    display: block;
    background: linear-gradient(160deg, var(--nsc-bg) 0%, var(--nsc-bg-deep) 100%);
    color: var(--nsc-ink);
    border: 1px solid var(--nsc-border);
    border-radius: var(--nsc-radius);
    box-shadow: 0 10px 30px rgba(2, 6, 23, 0.45), inset 0 1px 0 rgba(148, 163, 184, 0.12);
    overflow: hidden;
  }

  .number-system-converter.is-error {
    border-color: var(--nsc-red);
    box-shadow: 0 0 0 1px var(--nsc-red), 0 10px 30px rgba(2, 6, 23, 0.45);
  }

  .number-system-converter__header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.1rem;
    background: rgba(245, 158, 11, 0.08);
    border-bottom: 1px solid var(--nsc-border);
  }

  .number-system-converter__header::before {
    content: '';
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 999px;
    background: var(--nsc-accent);
    box-shadow: 0 0 10px var(--nsc-accent);
    flex-shrink: 0;
  }

  .number-system-converter__title {
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--nsc-ink);
    letter-spacing: 0.02em;
  }

  .number-system-converter__sub {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--nsc-ink-muted);
    text-align: right;
  }

  .number-system-converter__body {
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .number-system-converter__label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--nsc-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .number-system-converter__input-row {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .number-system-converter__input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.7rem 0.9rem;
    font-size: 1.15rem;
    font-family: var(--nsc-mono);
    font-weight: 700;
    letter-spacing: 0.03em;
    border: 1px solid var(--nsc-border-strong);
    border-radius: 0.6rem;
    background: var(--nsc-bg-deep);
    color: var(--nsc-accent);
    caret-color: var(--nsc-accent);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .number-system-converter__input::placeholder {
    color: #475569;
    font-weight: 400;
  }

  .number-system-converter__input:focus {
    outline: none;
    border-color: var(--nsc-accent);
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.25);
  }

  .number-system-converter__input.is-error {
    border-color: var(--nsc-red);
    color: var(--nsc-red);
  }

  .number-system-converter__base-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
    gap: 0.5rem;
  }

  .number-system-converter__base-option {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.55rem 0.6rem;
    border: 1px solid var(--nsc-border);
    border-radius: 0.55rem;
    background: var(--nsc-bg-soft);
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--nsc-ink-muted);
    transition: border-color 0.12s ease, background 0.12s ease, color 0.12s ease, transform 0.12s ease;
    user-select: none;
  }

  .number-system-converter__base-option input {
    accent-color: var(--nsc-accent);
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
    margin: 0;
  }

  .number-system-converter__base-option:hover {
    border-color: var(--nsc-accent);
    color: var(--nsc-ink);
    transform: translateY(-1px);
  }

  .number-system-converter__base-option.is-active {
    border-color: var(--nsc-accent);
    background: var(--nsc-accent);
    color: var(--nsc-accent-ink);
    box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);
  }

  .number-system-converter__base-option.is-active input {
    accent-color: var(--nsc-accent-ink);
  }

  .number-system-converter__error {
    margin: 0;
    padding: 0.6rem 0.8rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #fecaca;
    background: rgba(248, 113, 113, 0.12);
    border-radius: 0.55rem;
    border: 1px solid rgba(248, 113, 113, 0.4);
  }

  .number-system-converter__results {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: 0.25rem;
  }

  .number-system-converter__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.75rem;
    border-radius: 0.55rem;
    font-size: 0.92rem;
    background: rgba(148, 163, 184, 0.07);
    border: 1px solid transparent;
  }

  .number-system-converter__row--highlight {
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.45);
  }

  .number-system-converter__label {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--nsc-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    flex-shrink: 0;
  }

  .number-system-converter__value {
    font-family: var(--nsc-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--nsc-ink);
    word-break: break-all;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .number-system-converter__row--highlight .number-system-converter__value {
    color: var(--nsc-accent);
    font-size: 1.1rem;
  }

  .number-system-converter__row--ascii .number-system-converter__value {
    font-size: 0.95rem;
    color: var(--nsc-green);
  }

  .number-system-converter__error-marker {
    margin-left: 0.35rem;
    font-size: 0.9rem;
  }
</style>

<script>
  import { BASES, normalizeBaseN, baseToDecimal, decimalToBinary, decimalToOctal, decimalToHex, asciiCodeToChar } from '../js/number-systems.js';
  function initConverter(root) {
    const input = root.querySelector('[data-nsc-input]');
    if (!input || input.dataset.nscBound === '1') return;
    input.dataset.nscBound = '1';
    const radios = Array.from(root.querySelectorAll('[data-nsc-base]'));
    const errEl = root.querySelector('[data-nsc-error]');
    const resEl = root.querySelector('[data-nsc-results]');
    const subEl = root.querySelector('[data-nsc-sub]');
    const out = {
      bin: root.querySelector('[data-nsc-out-binary]'),
      oct: root.querySelector('[data-nsc-out-octal]'),
      dec: root.querySelector('[data-nsc-out-decimal]'),
      hex: root.querySelector('[data-nsc-out-hex]'),
      asc: root.querySelector('[data-nsc-out-ascii]'),
    };
    function curBase() {
      const c = radios.find((r) => r.checked);
      const v = c ? Number(c.value) : BASES.DECIMAL;
      return Number.isInteger(v) ? v : BASES.DECIMAL;
    }
    function render() {
      const raw = String(input.value ?? '').trim();
      const base = curBase();
      root.querySelectorAll('.number-system-converter__base-option').forEach((lb) => {
        const rd = lb.querySelector('input[type="radio"]');
        lb.classList.toggle('is-active', !!(rd && rd.checked));
      });
      try {
        if (raw === '') throw new Error('Değer boş olamaz.');
        normalizeBaseN(raw, base, 'girdi');
        const dec = baseToDecimal(raw, base);
        out.bin.textContent = decimalToBinary(dec);
        out.oct.textContent = decimalToOctal(dec);
        out.dec.textContent = String(dec);
        out.hex.textContent = decimalToHex(dec);
        try { out.asc.textContent = asciiCodeToChar(dec); } catch { out.asc.textContent = '—'; }
        if (errEl) { errEl.textContent = ''; errEl.hidden = true; }
        if (resEl) resEl.hidden = false;
        if (subEl) subEl.textContent = 'Değeri seçilen tabandan diğer tabanlara çevir';
        root.classList.remove('is-error');
        input.classList.remove('is-error');
      } catch (e) {
        const msg = e instanceof Error ? e.message : String(e);
        if (errEl) { errEl.textContent = msg; errEl.hidden = false; }
        if (resEl) resEl.hidden = true;
        if (subEl) subEl.textContent = 'Giriş kontrol edin';
        root.classList.add('is-error');
        input.classList.add('is-error');
      }
    }
    input.addEventListener('input', render);
    radios.forEach((r) => r.addEventListener('change', render));
  }
  function initAll(rootDoc) {
    const doc = rootDoc || document;
    doc.querySelectorAll('[data-number-system-converter]').forEach((root) => {
      try { initConverter(root); } catch (err) { console.error('[nsc] init failed', err); }
    });
  }
  initAll();
  // Starlight View Transitions ile sayfa değişimlerinde betik yeniden
  // çalışmayabilir; bu olaylarda da bağlamayı tekrar dene.
  document.addEventListener('astro:page-load', () => initAll());
  document.addEventListener('astro:after-swap', (e) => {
    try { initAll(e && e.target && e.target.ownerDocument ? e.target.ownerDocument : document); } catch { initAll(); }
  });
</script>

