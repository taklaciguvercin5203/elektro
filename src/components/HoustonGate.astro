---
import AiAssistant from './AiAssistant.astro';

/**
 * HoustonGate — ince kapı bekçisi, HER sayfada basılır (~3KB).
 *
 * Gizleme kararı SUNUCU tarafından cookie üzerinden alınır, bu yüzden
 * HTML render edilirken zaten data-ha-hidden="true" yazılmış olur ve
 * JS çalışmadan önce hiç bir flaş (FOUC) çıkmamış olur.
 *
 * hideHouston=true  -> AiAssistant data-ha-hidden="true" ile render edilir,
 *                      houston-core.js import edilmez, sadece radio butonu görünür.
 * hideHouston=false -> AiAssistant normal görünür, çekirdek import edilir.
 */
let hideHouston = false;
try {
  hideHouston = Astro.cookies.get('hideHouston')?.value === 'true';
} catch (e) {
  // Statik build (prerender) sırasında cookie'ye erişilemez; false kalır.
}
---

<div id="ha-gate" data-shell-url={import.meta.env.BASE_URL}></div>

<AiAssistant hideHouston={hideHouston} />

<button
  type="button"
  class="ha-gate-radio"
  id="ha-gate-radio"
  title="Houston'ı geri getir"
  aria-label="Houston'ı geri getir"
  {hideHouston ? undefined : 'hidden'} style="display: none;">

  <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M10 3.5L5.5 8 10 12.5" />
  </svg>
</button>

<style>
  /* Kapı sekmesi: AiAssistant kapalıyken sağ kenarda duran tek şey. */
  .ha-gate-radio {
    position: fixed;
    inset-block-end: max(1rem, env(safe-area-inset-bottom, 0px));
    inset-inline-end: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--sl-color-hairline-light);
    border-inline-end: none;
    border-start-start-radius: 0.45rem;
    border-end-start-radius: 0.45rem;
    background: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }

  .ha-gate-radio[hidden] {
    display: none !important;
  }

  .ha-gate-radio:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text-accent);
  }

  .ha-gate-radio:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
</style>

<script>
  // HoustonGate: hideHouston=true ise AiAssistant HTML'de data-ha-hidden="true"
  // ile zaten gizli gelir; houston-core.js import edilmez.
  // Radio butonuna basıldığında cookie silinip sayfa yenilenir.
  (function () {
    var KEY = 'hideHouston';
    var radio = document.getElementById('ha-gate-radio');
    var html = document.documentElement;

    function setCookie(name, value, days) {
      var d = new Date();
      d.setTime(d.getTime() + days * 24 * 60 * 60 * 1000);
      document.cookie = name + '=' + value + '; expires=' + d.toUTCString() + '; path=/; SameSite=Lax';
    }

    function removeCookie(name) {
      document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
    }

    function isHidden() {
      try { return localStorage.getItem(KEY) === 'true'; } catch (e) { return false; }
    }

    function showRadio(show) {
      if (radio) radio.hidden = !show;
    }

    function onRadio(e) {
      if (e && e.stopPropagation) e.stopPropagation();
      // Cookie ve localStorage temizle.
      removeCookie(KEY);
      try { localStorage.removeItem(KEY); } catch (err) {}
      if (html) html.removeAttribute('data-ha-hidden');
      showRadio(false);
      // Çekirdeği yükle ve başlat.
      import('../js/houston-core.js').then(function (m) {
        m.initHouston({ baseUrl: document.baseURI, isDev: false });
        m.recallHouston();
      }).catch(function (err) { console.error('Houston core yüklenemedi:', err); });
    }

    function gate() {
      if (isHidden()) {
        if (html) html.setAttribute('data-ha-hidden', 'true');
        showRadio(true);
        radio.style.display='block';
        return;
      }
      if (html) html.removeAttribute('data-ha-hidden');
      showRadio(false);
      // Normal akış: çekirdeği yükle ve başlat.
      import('../js/houston-core.js').then(function (m) {
        m.initHouston({ baseUrl: document.baseURI, isDev: false });
      }).catch(function (err) { console.error('Houston core yüklenemedi:', err); });
    }

    if (!window.__haGateWired) {
      window.__haGateWired = true;
      if (radio) radio.addEventListener('click', onRadio);

      // Çekirdek kapanınca (ha:hidden) cookie + localStorage true olarak ayarlanır.
      document.addEventListener('ha:hidden', function () {
        setCookie(KEY, 'true', 365);
        try { localStorage.setItem(KEY, 'true'); } catch (err) {}
        if (html) html.setAttribute('data-ha-hidden', 'true');
        showRadio(true);
      });

      document.addEventListener('astro:after-swap', gate);
      document.addEventListener('astro:page-load', gate);
    }
    gate();
  })();
</script>
