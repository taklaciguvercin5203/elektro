  }

  .ha-icon-btn:hover {
    border-color: var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  /* --- Görünüm kapsayıcıları --- */
  .ha-view {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

</style>

